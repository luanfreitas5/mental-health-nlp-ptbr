{
  // ==========================================================================
  // Dev Container — ambiente de desenvolvimento reprodutível.
  //
  // Garante que o projeto rode de forma idêntica em qualquer máquina, sem
  // depender do que cada pessoa tem instalado localmente.
  // ==========================================================================
  "name": "mental-health-nlp-ptbr",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },

  "postCreateCommand": "uv sync --dev && uv run pre-commit install",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "detachhead.basedpyright",
        "ms-toolsai.jupyter",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/mental-health-nlp-ptbr/.venv/bin/python",
        "python.analysis.extraPaths": ["${workspaceFolder}/src"],
        "python.testing.pytestEnabled": true,
        "files.eol": "\n"
      }
    }
  },

  "remoteEnv": {
    // `src/` é a raiz de importação do projeto.
    "PYTHONPATH": "${containerWorkspaceFolder}/src",
    "PYTHONHASHSEED": "42"
  },

  // MLflow (5000), Streamlit (8501), MkDocs (8000).
  "forwardPorts": [5000, 8000, 8501],
  "portsAttributes": {
    "5000": { "label": "MLflow" },
    "8000": { "label": "MkDocs" },
    "8501": { "label": "Dashboard" }
  },

  // Usuário não-root: evita arquivos com dono errado nos volumes montados.
  "remoteUser": "vscode"
}
